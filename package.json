{
  "name": "telos",
  "version": "0.1.0",
  "description": "Terminal-native agentic coding CLI: persistent manager, evidence-based completion gate, hard runtime budgets.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zainaqdas/Telos.git"
  },
  "homepage": "https://github.com/zainaqdas/Telos#readme",
  "bugs": "https://github.com/zainaqdas/Telos/issues",
  "keywords": ["ai", "agent", "coding", "cli", "terminal", "agentic", "coding-agent"],
  "bin": { "telos": "./bin/telos.js" },
  "files": ["bin/", "src/", "README.md"],
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts",
    "eval:scenarios": "node --experimental-strip-types --no-warnings evals/scenarios/scenario.ts",
    "eval:acceptance": "node --experimental-strip-types --no-warnings evals/acceptance/acceptance.ts",
    "bench": "node --experimental-strip-types --no-warnings evals/bench.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
